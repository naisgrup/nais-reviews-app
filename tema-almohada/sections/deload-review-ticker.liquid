{%- comment -%}
  Base — Mini reseñas rotativas. Banda fina de ancho completo bajo la cabecera, en todas las
  páginas (se inserta en sections/header-group.json). Rota entre las reseñas con un fundido,
  se pausa con el ratón y respeta prefers-reduced-motion. Todo el texto es editable.

  Regla de contenido: solo muestra reseñas reales de clientes. Está DESACTIVADA por defecto y
  los bloques que empiezan por [PLACEHOLDER] no se muestran en la tienda (solo en el editor,
  para ver el diseño). Sin reseñas reales, la sección no renderiza nada.
{%- endcomment -%}
{%- liquid
  assign link = section.settings.link | strip
  assign stars_e = section.settings.stars_label | escape
  assign vf_e = section.settings.verified_label | escape
  assign n = 0
  capture slides
    for block in section.blocks
      assign q = block.settings.quote | strip
      if q == blank
        continue
      endif
      if q contains '[PLACEHOLDER' and request.design_mode != true
        continue
      endif
      assign n = n | plus: 1
      assign q_e = q | escape
      assign who_e = block.settings.name | strip | escape
      assign city_e = block.settings.city | strip | escape
      echo '<div class="rt__slide" data-rt-slide ' | append: block.shopify_attributes | append: '>'
      echo '<span class="rt__stars" aria-hidden="true">★★★★★</span>'
      echo '<span class="rt__sr">' | append: stars_e | append: '</span>'
      echo '<q class="rt__quote">' | append: q_e | append: '</q>'
      if who_e != blank
        echo '<span class="rt__by"><span class="rt__name">' | append: who_e
        if city_e != blank
          echo ', ' | append: city_e
        endif
        echo '</span>'
        if block.settings.verified
          echo '<svg class="rt__vf" viewBox="0 0 24 24" role="img" aria-label="' | append: vf_e | append: '"><title>' | append: vf_e | append: '</title><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>'
        endif
        echo '</span>'
      endif
      echo '</div>'
    endfor
  endcapture
-%}
{%- if section.settings.enabled and n > 0 -%}
  {%- style -%}
    #shopify-section-{{ section.id }} .rt{
      --rt-bg:{{ section.settings.bg_color }};--rt-ink:{{ section.settings.text_color }};--rt-accent:{{ section.settings.accent_color }};
      background:var(--rt-bg);color:var(--rt-ink);border-bottom:1px solid var(--dl-line, rgba(43,38,34,.12));position:relative;z-index:1
    }
    #shopify-section-{{ section.id }} .rt__band{display:block;color:inherit;text-decoration:none;padding:6px var(--dl-gutter, 16px)}
    #shopify-section-{{ section.id }} .rt__band.is-link{cursor:pointer}
    #shopify-section-{{ section.id }} .rt__band:focus-visible{outline:2px solid var(--rt-accent);outline-offset:-3px}
    #shopify-section-{{ section.id }} .rt__stack{display:grid;max-width:var(--dl-maxw, 1180px);margin:0 auto}
    #shopify-section-{{ section.id }} .rt__slide{
      grid-area:1/1;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;column-gap:.7em;row-gap:0;
      text-align:center;font-family:var(--dl-sans, inherit);font-size:13.5px;line-height:1.2;
      opacity:0;visibility:hidden;transition:opacity .6s ease,visibility 0s linear .6s
    }
    #shopify-section-{{ section.id }} .rt__slide.is-on{opacity:1;visibility:visible;transition:opacity .6s ease,visibility 0s}
    #shopify-section-{{ section.id }} .rt__stars{color:var(--rt-accent);letter-spacing:.08em;font-size:13px;white-space:nowrap}
    #shopify-section-{{ section.id }} .rt__quote{font-style:italic;quotes:"\201C" "\201D";font-weight:500}
    #shopify-section-{{ section.id }} .rt__quote::before{content:open-quote}
    #shopify-section-{{ section.id }} .rt__quote::after{content:close-quote}
    #shopify-section-{{ section.id }} .rt__by{display:inline-flex;align-items:center;gap:.4em;font-size:12px;font-weight:600;letter-spacing:.01em;opacity:.85;white-space:nowrap}
    #shopify-section-{{ section.id }} .rt__name::before{content:"\2014\00a0"}
    #shopify-section-{{ section.id }} .rt__vf{width:13px;height:13px;flex:none;color:var(--rt-accent)}
    #shopify-section-{{ section.id }} .rt__sr{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
    @media (max-width:749px){
      #shopify-section-{{ section.id }} .rt__band{padding:4px var(--dl-gutter, 16px)}
      #shopify-section-{{ section.id }} .rt__slide{flex-direction:column;flex-wrap:nowrap;row-gap:2px;font-size:12.5px;line-height:1.2}
      #shopify-section-{{ section.id }} .rt__stars{order:2;display:none}
      #shopify-section-{{ section.id }} .rt__quote{order:1;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}
      #shopify-section-{{ section.id }} .rt__by{order:3;font-size:11.5px}
      #shopify-section-{{ section.id }} .rt__by::before{content:"★★★★★";color:var(--rt-accent);letter-spacing:.06em;font-size:11px;margin-right:.35em;font-weight:400}
    }
    @media (prefers-reduced-motion:reduce){
      #shopify-section-{{ section.id }} .rt__slide,#shopify-section-{{ section.id }} .rt__slide.is-on{transition:none}
    }
  {%- endstyle -%}

  <div class="rt" data-rt data-interval="{{ section.settings.interval }}" role="region" aria-label="{{ section.settings.region_label | escape }}">
    <a class="rt__band" data-rt-band href="{{ link | default: '#' | escape }}">
      <div class="rt__stack">{{ slides }}</div>
    </a>
  </div>

  <script>
    (function () {
      var root = document.querySelector('#shopify-section-{{ section.id }} [data-rt]');
      if (!root || root.__rt) return;
      root.__rt = true;
      var slides = [].slice.call(root.querySelectorAll('[data-rt-slide]'));
      var band = root.querySelector('[data-rt-band]');
      var cur = 0, timer = null, hover = false;
      var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
      var every = Math.max(2, parseInt(root.getAttribute('data-interval'), 10) || 5) * 1000;

      function show(i) {
        cur = (i + slides.length) % slides.length;
        slides.forEach(function (s, k) { s.classList.toggle('is-on', k === cur); s.setAttribute('aria-hidden', k === cur ? 'false' : 'true'); });
      }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      function start() {
        stop();
        if (reduce || slides.length < 2 || hover || document.hidden) return;
        timer = setInterval(function () { show(cur + 1); }, every);
      }
      show(0);
      root.addEventListener('mouseenter', function () { hover = true; stop(); });
      root.addEventListener('mouseleave', function () { hover = false; start(); });
      root.addEventListener('focusin', function () { hover = true; stop(); });
      root.addEventListener('focusout', function () { hover = false; start(); });
      document.addEventListener('visibilitychange', function () { document.hidden ? stop() : start(); });
      /* En el editor, al seleccionar un bloque se muestra esa reseña. */
      root.closest('.shopify-section').addEventListener('shopify:block:select', function (e) {
        var k = slides.indexOf(e.target); if (k > -1) { hover = true; stop(); show(k); }
      });
      root.closest('.shopify-section').addEventListener('shopify:block:deselect', function () { hover = false; start(); });

      /* Enlace: #ancla con scroll suave si existe en la página (se busca cuando el documento ya
         está cargado, porque esta banda va antes del contenido); si no existe, no es un enlace. */
      var href = band.getAttribute('href') || '';
      function find() { try { return href.length > 1 ? document.querySelector(href) : null; } catch (e) { return null; } }
      if (href.charAt(0) === '#') {
        var setup = function () {
          if (!find()) { band.removeAttribute('href'); band.classList.remove('is-link'); }
          else band.classList.add('is-link');
        };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setup); else setup();
        band.addEventListener('click', function (e) {
          var t = find(); if (!t) return;
          e.preventDefault();
          t.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        });
      } else if (href) { band.classList.add('is-link'); }
      start();
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Mini reseñas rotativas",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Solo reseñas REALES de clientes. Los bloques que empiezan por [PLACEHOLDER] no se muestran en la tienda; sustitúyelos por reseñas reales y activa la banda." },
    { "type": "checkbox", "id": "enabled", "label": "Activar la banda", "default": false },
    { "type": "range", "id": "interval", "label": "Segundos entre reseñas", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 5 },
    { "type": "text", "id": "link", "label": "Destino al hacer clic", "default": "#reviews", "info": "#ancla de esta página (scroll suave) o un enlace. Si el ancla no existe en la página, la banda no es clicable." },
    { "type": "text", "id": "verified_label", "label": "Texto del icono de comprador verificado", "default": "Verified Buyer" },
    { "type": "text", "id": "stars_label", "label": "Texto de las estrellas (lectores de pantalla)", "default": "5 out of 5 stars" },
    { "type": "text", "id": "region_label", "label": "Etiqueta de accesibilidad de la banda", "default": "Customer reviews" },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#F4EDE3" },
    { "type": "color", "id": "text_color", "label": "Texto", "default": "#2B2622" },
    { "type": "color", "id": "accent_color", "label": "Acento (estrellas e icono)", "default": "#B08D57" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Reseña",
      "settings": [
        { "type": "text", "id": "quote", "label": "Frase corta", "info": "Máximo ~70 caracteres, sin comillas (se añaden solas)." },
        { "type": "text", "id": "name", "label": "Nombre del cliente (ej. Amanda L.)" },
        { "type": "text", "id": "city", "label": "Ciudad" },
        { "type": "checkbox", "id": "verified", "label": "Comprador verificado", "default": true }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Mini reseñas rotativas",
      "settings": { "enabled": false },
      "blocks": [
        { "type": "review", "settings": { "quote": "[PLACEHOLDER] Real customer quote 1", "name": "[PLACEHOLDER] Name", "city": "City", "verified": true } },
        { "type": "review", "settings": { "quote": "[PLACEHOLDER] Real customer quote 2", "name": "[PLACEHOLDER] Name", "city": "City", "verified": true } },
        { "type": "review", "settings": { "quote": "[PLACEHOLDER] Real customer quote 3", "name": "[PLACEHOLDER] Name", "city": "City", "verified": true } }
      ]
    }
  ]
}
{% endschema %}
