# Contraseña para entrar al panel de administración (obligatoria)
ADMIN_PASSWORD=cambia-esto
# Dominios de tu tienda que pueden enviar reseñas (separados por coma). Ej: mi-tienda.myshopify.com,www.mitienda.com
ALLOWED_ORIGINS=*
# Ruta de la base de datos SQLite (en Render con disco: /var/data/reviews.db)
DB_PATH=./data/reviews.db
PORT=3000
